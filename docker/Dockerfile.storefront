# =============================================================================
# Stage 1: Chef base image with cargo-chef installed
# =============================================================================
FROM rust:1.95.0-trixie@sha256:4a7e3a0c309c9bab658e469f842711bd595fae484936bc5d605e08ca0c631bf4 AS chef
RUN cargo install cargo-chef --locked
WORKDIR /app

# =============================================================================
# Stage 2: Planner - creates recipe.json capturing the exact dependency graph
# =============================================================================
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo chef prepare --recipe-path recipe.json

# =============================================================================
# Stage 3: Deps builder - compiles dependencies only (cached when recipe unchanged)
# =============================================================================
FROM chef AS deps-builder

# Install build dependencies including mold linker for faster linking
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config=1.8.1-4 \
    libssl-dev=3.5.4-1~deb13u2 \
    mold=2.37.1+dfsg-1 \
    && rm -rf /var/lib/apt/lists/*

# Use mold linker for faster linking
ENV RUSTFLAGS="-C link-arg=-fuse-ld=mold"

COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json

# =============================================================================
# Stage 4: Builder - compiles actual source code (deps already cached)
# =============================================================================
FROM deps-builder AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install Tailwind CSS CLI with checksum verification
ARG TAILWIND_VERSION=4.2.2
ARG TAILWIND_SHA256=4ab84f2b496c402d3ec4fd25e0e5559fe1184d886dadae8fb4438344ec044c22
RUN curl -sLO https://github.com/tailwindlabs/tailwindcss/releases/download/v${TAILWIND_VERSION}/tailwindcss-linux-x64 \
    && echo "${TAILWIND_SHA256}  tailwindcss-linux-x64" | sha256sum -c - \
    && chmod +x tailwindcss-linux-x64 && mv tailwindcss-linux-x64 /usr/local/bin/tailwindcss

# Use sqlx offline mode (reads from .sqlx cache instead of live database)
ENV SQLX_OFFLINE=true

COPY . .

# Build application
RUN tailwindcss -i ./crates/storefront/static/css/input.css \
    -o ./crates/storefront/static/css/main.css --minify \
    && cargo build --release --locked -p naked-pineapple-storefront

# =============================================================================
# Stage 5: Runtime - distroless image for production
# =============================================================================
FROM gcr.io/distroless/cc-debian13@sha256:56aaf20ab2523a346a67c8e8f8e8dabe447447d0788b82284d14ad79cd5f93cc AS runtime

# OCI image metadata (values injected by CI via --build-arg or Docker --label)
ARG VERSION=0.1.0
ARG COMMIT_SHA
ARG BUILD_DATE
LABEL org.opencontainers.image.title="Pineapple Skin Co. Storefront" \
      org.opencontainers.image.description="Public e-commerce storefront for Pineapple Skin Co. skincare" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.authors="Adam Walz <adam@pineappleskinco.com>" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      org.opencontainers.image.url="https://pineappleskinco.com" \
      org.opencontainers.image.source="https://github.com/NakedPineapple/shopify-headless" \
      org.opencontainers.image.revision="${COMMIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.vendor="Pineapple Skin Co LLC" \
      org.opencontainers.image.base.name="gcr.io/distroless/cc-debian13" \
      org.opencontainers.image.security.no-new-privileges="true"

WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /app/target/release/naked-pineapple-storefront /app/server
COPY --from=builder --chown=nonroot:nonroot /app/crates/storefront/templates /app/crates/storefront/templates
COPY --from=builder --chown=nonroot:nonroot /app/crates/storefront/content /app/crates/storefront/content
# Images served from CDN — only CSS, JS, vendor, and fonts are bundled
COPY --from=builder --chown=nonroot:nonroot /app/crates/storefront/static/css /app/crates/storefront/static/css
COPY --from=builder --chown=nonroot:nonroot /app/crates/storefront/static/js /app/crates/storefront/static/js
COPY --from=builder --chown=nonroot:nonroot /app/crates/storefront/static/vendor /app/crates/storefront/static/vendor
COPY --from=builder --chown=nonroot:nonroot /app/crates/storefront/static/fonts /app/crates/storefront/static/fonts

USER nonroot

EXPOSE 8080 9090
ENTRYPOINT ["/app/server"]
