# =============================================================================
# Pineapple Skin Co. Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# STOREFRONT CONFIGURATION
# =============================================================================

STOREFRONT_DATABASE_URL=postgres://user:pass@localhost/np_storefront
STOREFRONT_HOST=127.0.0.1
STOREFRONT_PORT=3000
STOREFRONT_HEALTH_PORT=9091
# First host is the default (used for origin derivation)
STOREFRONT_HOSTS=localhost
STOREFRONT_SESSION_SECRET=your-secure-session-secret-min-32-chars

# =============================================================================
# ADMIN CONFIGURATION (Tailscale-only)
# =============================================================================

ADMIN_DATABASE_URL=postgres://user:pass@localhost/np_admin
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3001
ADMIN_HEALTH_PORT=9091
# First host is the primary (used as WebAuthn RP ID)
ADMIN_HOSTS=localhost
ADMIN_SESSION_SECRET=your-secure-admin-session-secret-min-32-chars

# Storefront DB connection for support inbox (optional — enables support features)
# Uses the restricted `support_agent` role with access to support tables only
# STOREFRONT_DATABASE_URL=postgres://support_agent:pass@localhost/np_storefront

# =============================================================================
# SHOPIFY - STOREFRONT API (Public access)
# =============================================================================

SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-01
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=your-storefront-public-token
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your-storefront-private-token

# =============================================================================
# SHOPIFY - CUSTOMER ACCOUNT API (OAuth)
# =============================================================================
# Shop ID is the numeric ID found in your Shopify admin URL (e.g., admin.shopify.com/store/71655391511)

SHOPIFY_CUSTOMER_SHOP_ID=71655391511
SHOPIFY_CUSTOMER_CLIENT_ID=your-customer-client-id
SHOPIFY_CUSTOMER_CLIENT_SECRET=your-customer-client-secret

# =============================================================================
# SHOPIFY - ADMIN API OAuth (HIGH PRIVILEGE - Admin binary only)
# =============================================================================

SHOPIFY_ADMIN_CLIENT_ID=your-admin-client-id
SHOPIFY_ADMIN_CLIENT_SECRET=your-admin-client-secret

# =============================================================================
# CLAUDE API (Admin + Storefront chat support)
# =============================================================================

CLAUDE_API_KEY=your-claude-api-key

# =============================================================================
# CLOUDFLARE TURNSTILE (Storefront chat bot protection)
# =============================================================================
# Optional: If not set, chat support is disabled
# Get keys from https://dash.cloudflare.com/turnstile

TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# =============================================================================
# ANALYTICS
# =============================================================================

# Cloudflare Web Analytics beacon tokens (optional)
# JSON map of domain -> token. Empty or unset disables the beacon.
# CF_BEACON_TOKENS={"nakedpineapple.co":"token-a","pineappleskinco.com":"token-b"}

# Google Analytics 4 (optional - analytics disabled if not set)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel (optional)
META_PIXEL_ID=1234567890123456

# Google Ads Conversion Tracking (optional)
GOOGLE_ADS_ID=AW-1234567890
GOOGLE_ADS_CONVERSION_LABEL=AbCdEfGhIjKlMnOp

# TikTok Pixel (optional)
TIKTOK_PIXEL_ID=C0123456789ABCDEF0123456789ABCDEF01234567

# Pinterest Tag (optional)
PINTEREST_TAG_ID=1234567890123

# Snapchat Pixel (optional)
SNAPCHAT_PIXEL_ID=12345678-1234-1234-1234-123456789012

# Microsoft/Bing UET Tag (optional)
MICROSOFT_UET_ID=12345678

# Twitter/X Pixel (optional)
TWITTER_PIXEL_ID=o1234

# Mixpanel Product Analytics (optional)
MIXPANEL_PROJECT_TOKEN=your-mixpanel-token

# Crazy Egg Heatmaps & A/B Testing (optional)
CRAZY_EGG_ACCOUNT_ID=12345678

# Shopify Webhook Secret (optional - for server-side purchase tracking)
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# ERROR TRACKING
# =============================================================================

SENTRY_DSN=https://key@sentry.io/project
SENTRY_DSN_PUBLIC=https://public-key@sentry.io/project
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=1.0

# =============================================================================
# OPENAI API (Admin + Storefront chat support - for embeddings)
# =============================================================================

OPENAI_API_KEY=sk-your-openai-api-key

# =============================================================================
# SLACK INTEGRATION (Admin binary only - for write operation confirmations)
# =============================================================================
# Optional: If not set, write operations execute without Slack approval

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CHANNEL_ID=C0123456789

# =============================================================================
# KLAVIYO (Optional - newsletter subscription and campaign management)
# =============================================================================
# Required scopes: Profiles (Full), Campaigns (Full), List (Read), Subscriptions (Full)
# Both variables must be set together for Klaviyo integration to be enabled

KLAVIYO_API_KEY=pk_your-klaviyo-private-api-key
KLAVIYO_LIST_ID=your-newsletter-list-id

# =============================================================================
# EMAIL (Admin binary only)
# =============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@pineappleskinco.com

# =============================================================================
# MICROSOFT 365 (Email automation service)
# =============================================================================
# Azure AD app registration with Mail.ReadWrite + Mail.Send application permissions

M365_TENANT_ID=your-azure-ad-tenant-id
M365_CLIENT_ID=your-azure-ad-client-id
M365_CLIENT_SECRET=your-azure-ad-client-secret
M365_SHARED_MAILBOXES=info@nakedpineapple.co,support@nakedpineapple.co

# =============================================================================
# CLOUDFLARE R2 DOCUMENT STORAGE (Admin binary only - enables document upload)
# =============================================================================
# Optional: If not set, document upload is disabled
# R2 uses S3-compatible API with a custom endpoint

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_DOCUMENTS=nakedpineapple-documents
R2_BUCKET_ORIGINAL_IMAGES=nakedpineapple-original-images

# =============================================================================
# JUDGE.ME (Product reviews - optional)
# =============================================================================
# Optional: If not set, review features are disabled on both storefront and admin
# Get your API token from https://judge.me/settings/public-api

JUDGEME_API_TOKEN=your-judgeme-api-token

# =============================================================================
# META COMMERCE (Facebook Shop + Instagram Shopping)
# =============================================================================

META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_COMMERCE_ACCOUNT_ID=
META_CATALOG_ID=
AUTOMATION_META_ORDER_POLL_INTERVAL_SECS=3600

# =============================================================================
# TIKTOK SHOP (Background sync intervals)
# =============================================================================

AUTOMATION_TIKTOK_ORDER_POLL_INTERVAL_SECS=3600
AUTOMATION_TIKTOK_SETTLEMENT_POLL_INTERVAL_SECS=86400
AUTOMATION_TIKTOK_RETURN_POLL_INTERVAL_SECS=3600
AUTOMATION_TIKTOK_PERFORMANCE_POLL_INTERVAL_SECS=86400

# =============================================================================
# PINTEREST (Catalog Sync + Conversions API)
# =============================================================================

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_AD_ACCOUNT_ID=
AUTOMATION_PINTEREST_CONVERSION_POLL_INTERVAL_SECS=900

# =============================================================================
# EMAIL AUTOMATION (Scheduler tuning - all optional)
# =============================================================================

AUTOMATION_HEALTH_PORT=9092
# AUTOMATION_EMAIL_POLL_INTERVAL_SECS=120
# AUTOMATION_CART_CHECK_INTERVAL_SECS=900
# AUTOMATION_STOCK_CHECK_INTERVAL_SECS=3600
# AUTOMATION_SEGMENT_SYNC_INTERVAL_SECS=86400
# AUTOMATION_ORDER_POLL_INTERVAL_SECS=300
# AUTOMATION_SUBSCRIPTION_CHECK_INTERVAL_SECS=86400
# AUTOMATION_CART_ABANDON_DELAY_MINUTES=60
# AUTOMATION_LOW_STOCK_THRESHOLD=10
# AUTOMATION_LOW_STOCK_EMAIL_RECIPIENTS=
# AUTOMATION_SUBSCRIPTION_RENEWAL_REMINDER_DAYS=3
# AUTOMATION_SUBSCRIPTION_WINBACK_DELAY_DAYS=14
# AUTOMATION_AUTO_RESPOND_THRESHOLD=0.85

# Storefront sync (optional — enables search index refresh on product changes)
# STOREFRONT_INTERNAL_URL=http://localhost:9091

# Business summary email scheduling (all optional)
# AUTOMATION_SUMMARY_CHECK_INTERVAL_SECS=60
# AUTOMATION_DAILY_SUMMARY_HOUR=7
# AUTOMATION_DAILY_SUMMARY_MINUTE=0
# AUTOMATION_WEEKLY_SUMMARY_DAY=monday
# AUTOMATION_WEEKLY_SUMMARY_HOUR=7
# AUTOMATION_WEEKLY_SUMMARY_MINUTE=0
# AUTOMATION_SUMMARY_EMAIL_RECIPIENTS=you@example.com,team@example.com
