# Build artifacts
target/

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.*
!.env.example

# Documentation
*.md
!crates/storefront/content/**/*.md
LICENSE*

# CI/CD
.github/

# Claude Code settings
.claude/

# Fly configs (not needed in build)
fly/

# Docker configs (not needed inside build context)
docker/

# Dev tooling configs
lefthook.yml
cog.toml

# Local development
docker-compose/
~/.cargo/

# Generated CSS assets (rebuilt during Docker build)
crates/storefront/static/css/derived/

# Images - original images not needed in Docker (served from R2 CDN)
# Derived images are generated and uploaded to R2 separately
crates/storefront/static/images/original/
crates/storefront/static/images/derived/

# Node modules (reinstalled in Docker)
node_modules/
scripts/image-optimizer/node_modules/

# Integration test sources (workspace manifest needed, test sources not)
crates/integration-tests/tests/
