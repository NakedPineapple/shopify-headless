{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, email_type, to_address, to_name,\n               subject, body_html,\n               attempts, max_attempts\n        FROM admin.outbound_email_queue\n        WHERE status = 'queued'\n          AND scheduled_for <= NOW()\n          AND attempts < max_attempts\n        ORDER BY scheduled_for ASC\n        LIMIT $1\n        ",
