{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            from_address,\n            from_name,\n            subject,\n            mailbox,\n            folder,\n            is_read as \"is_read!\",\n            classification,\n            confidence,\n            status,\n            received_at as \"received_at: DateTime<Utc>\",\n            (response_draft IS NOT NULL) as \"has_draft!: bool\",\n            reviewed_by,\n            error\n        FROM admin.inbound_email\n        WHERE status IN ('responded', 'archived')\n        ORDER BY received_at DESC\n        LIMIT $1 OFFSET $2\n        ",
