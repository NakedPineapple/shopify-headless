  "query": "\n        SELECT\n            id,\n            from_address,\n            from_name,\n            subject,\n            body_preview,\n            received_at as \"received_at: DateTime<Utc>\",\n            status\n        FROM admin.inbound_email\n        WHERE conversation_id = $1 AND id != $2\n        ORDER BY received_at ASC\n        ",
