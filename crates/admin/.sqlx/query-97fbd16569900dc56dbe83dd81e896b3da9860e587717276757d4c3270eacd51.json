{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            from_address,\n            subject,\n            COALESCE(body_preview, '') AS \"body_preview!\",\n            classification,\n            1 - (embedding <=> $1::text::vector) AS \"similarity!\"\n        FROM admin.inbound_email\n        WHERE embedding IS NOT NULL\n          AND ($3::int IS NULL OR id != $3)\n        ORDER BY embedding <=> $1::text::vector\n        LIMIT $2\n        ",
